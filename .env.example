# Relay backend environment (copy to backend/.env for local dev)

NODE_ENV=development
PORT=3100
FRONTEND_ORIGIN=http://localhost:5174

# Postgres (docker-compose maps host port 5433 -> container 5432)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=relay

# Auth (Google OAuth + JWT) - reused from the backoffice pattern
JWT_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3100/auth/google/callback
ALLOWED_EMAIL_DOMAIN=apono.io

# Role given to a person on first sign-in (admin | developer | viewer)
DEFAULT_PERSON_ROLE=developer

# Bootstrap admins - these addresses become admin on sign-in, so a fresh
# deployment always has someone who can open the People page
ADMIN_EMAILS=dor.s@apono.io

# GitHub account linking - a GitHub OAuth App, separate from the ingestion PAT
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3100/auth/github/callback

# Pull requests probed per author login when seeding the roster from commit emails
PEOPLE_SEED_PRS_PER_AUTHOR=3

# GitHub - LOCAL Phase 1 uses a read-only fine-grained PAT
GITHUB_AUTH_MODE=pat
GITHUB_PAT=

# GitHub - DEPLOYED path uses the GitHub App (unused locally)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Ingestion scope (Relay is multi-repo)
GITHUB_REPOS=apono-io/apono-mono,apono-io/Relay
BACKFILL_QUARTERS=3

# Metric defaults
DEFAULT_REVIEW_SLA_MINUTES=120
GAP_FILL_INTERVAL_MINUTES=1

# Review submitters treated as bots (excluded from pickup metrics and reviewer display)
GITHUB_BOT_REVIEWERS=github-code-quality,claude,copilot-pull-request-reviewer

# Assignment quiet phase
ASSIGNMENT_SWEEP_INTERVAL_MINUTES=5
SUGGESTION_MAX_PR_AGE_DAYS=7
ASSIGNMENT_GRACE_MINUTES=15
